{
  "name": "mrl-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc -p tsconfig.test.json",
    "migrate": "tsx --env-file=.env src/db/migrate.ts",
    "seed": "tsx --env-file=.env src/db/seed.ts",
    "db:ping": "tsx --env-file=.env src/db/ping.ts",
    "check": "tsx tests/utils/errors.check.ts && tsx tests/utils/password.check.ts && tsx --env-file=.env tests/utils/jwt.check.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@node-rs/argon2": "^2.2.1",
    "hono": "^4.13.8",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
