# ---- Database ----
# Dev lokal (Postgres di mesin sendiri):
DATABASE_URL=postgres://mrl:devpassword@localhost:5432/maintenance_request_log
# Di dalam Docker Compose (Step 20), host berubah jadi nama service:
# DATABASE_URL=postgres://mrl:devpassword@db:5432/maintenance_request_log

# ---- API ----
NODE_ENV=development
PORT=3000

# WAJIB diganti. Minimal 32 karakter.
# Hasilkan dengan: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_TTL_HOURS=8
